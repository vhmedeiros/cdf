# Database (PostgreSQL with pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=local_user
POSTGRES_PASSWORD=local_password
POSTGRES_DB=local_db
DATABASE_URL=postgres://local_user:local_password@localhost:5432/local_db

# Cache & Queues (Redis)
REDIS_URL=redis://localhost:6379

# Web Server
WEBSERVER_ORIGIN=http://localhost:3000

# E-mail (Mailcatcher in dev)
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=suporte@aula.local

# Google Drive & Streaming
GOOGLE_SA_FILE=./gdrive_sa.json
STREAM_MODE=node
PROGRESS_COMPLETE_RATIO=0.9

# PDF Parsing (Docling)
DOCLING_URL=http://localhost:5001

# AI (Google Gemini)
GEMINI_API_KEY=
AI_CHAINS_FILE=./config/ai-chains.yaml
AI_EMBED_MODEL=text-embedding-004
AI_LOCAL_URL=
AI_PAID_KEY=
AI_PAID_ENABLED=false

# Study & Questions
DAILY_QUESTION_GOAL_DEFAULT=20
SENTRY_DSN=
