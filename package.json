{
  "name": "cdf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "build": "next build",
    "start": "next start",
    "worker:dev": "tsx watch worker/index.ts",
    "seed": "tsx infra/scripts/seed.ts",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "tsx infra/scripts/wait-for-postgres.ts",
    "migrations:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migrations:up": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development up",
    "migrations:down": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development down",
    "lint:eslint:check": "next lint",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "test": "npm run services:up && npm run services:wait:database && npm run migrations:up && concurrently -n next,jest -k -s command-jest \"next dev\" \"jest --runInBand\"",
    "test:watch": "concurrently -n next,jest -k -s command-jest \"next dev\" \"jest --watch --runInBand\"",
    "commit": "cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "async-retry": "1.3.3",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.41.6",
    "cookie": "^0.7.2",
    "dotenv": "16.4.7",
    "dotenv-expand": "12.0.1",
    "google-auth-library": "^9.15.1",
    "ioredis": "^5.3.2",
    "next": "15.2.1",
    "next-connect": "1.0.0",
    "node-pg-migrate": "7.9.1",
    "nodemailer": "^6.10.0",
    "pg": "8.13.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@commitlint/cli": "19.7.1",
    "@commitlint/config-conventional": "19.7.1",
    "@faker-js/faker": "^9.5.0",
    "@types/async-retry": "1.4.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.9",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "8.11.11",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "commitizen": "4.3.1",
    "concurrently": "9.1.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.2.1",
    "eslint-config-prettier": "10.0.1",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-environment-node": "29.7.0",
    "prettier": "3.5.2",
    "ts-jest": "29.2.5",
    "tsx": "4.19.3",
    "typescript": "5.7.3"
  }
}
